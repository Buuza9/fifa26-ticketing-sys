# Copy to .env.local and fill in your Supabase project values.
# Both are PUBLIC by design — the anon key is meant to ship in client code.
# Security rests on Row Level Security + SECURITY DEFINER functions (see
# docs/SECURITY.md), not on hiding these. NEVER add the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
